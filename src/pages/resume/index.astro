---
// Web resume — Dahlian Ayu Novanti (Vanti), Yoga Instruktur.
// Self-contained page: does not use the blog layout. Everything for this page lives in this folder.
import photo from './_photo.jpg';

const profile = {
  nickname: 'Vanti',
  fullName: 'Dahlian Ayu Novanti',
  role: 'Yoga Instruktur',
  summary:
    'Certified 200 hours Yoga Teacher yang memiliki pengalaman mengajar lebih dari 4 tahun di berbagai studio dan privat. Memiliki keahlian dalam Hatha dan Vinyasa Yoga.',
  phone: '08561113406',
  waNumber: '628561113406',
  email: 'dahlian.ayunovanti@gmail.com',
  location: 'Rawamangun, Jakarta Timur',
  instagram: 'ayunovanti',
};

const skills = [
  'Hatha & Vinyasa Yoga',
  'Pemahaman anatomi tubuh',
  'Teknik pernapasan / pranayama',
  'Sequencing',
  'Kids Yoga',
  'Myofascial release',
];

const certifications = [
  { name: 'YTT-200', org: 'Yoga Mix', year: '2021' },
  { name: "Children's Yoga & Mindfulness TT", org: 'KidsYoga Jakarta', year: '2025' },
  { name: 'Workshop Myofascial Release Therapy & Yin Yoga', org: 'Yoga Mix', year: '2026' },
];

const experience = [
  {
    title: 'Instruktur Hatha Flow Yoga',
    place: 'Ayama Studio',
    period: '2023 – sekarang',
    points: [
      'Memimpin kelas Hatha yang fokus pada gerakan perlahan, namun dibuat mengalir.',
      'Kuota kelas: 5–15 peserta selama 90 menit.',
      'Terkadang memberikan tema dan peak pose yang berbeda setiap minggunya.',
      'Memberikan koreksi untuk pose yang aman, juga mengajarkan teknik pranayama.',
    ],
  },
  {
    title: 'Instruktur Hatha Yoga',
    place: 'Fithub Rawamangun',
    period: '2025 – sekarang',
    points: [
      'Memimpin kelas yoga untuk pemula hingga menengah, sekitar 10–20 peserta selama 60 menit.',
      'Memberikan koreksi untuk pose yang aman, disertai pranayama di awal / di akhir kelas.',
    ],
  },
  {
    title: 'Instruktur Basic Yoga',
    place: 'Lisfit (online)',
    period: '2023 – 2024',
    points: [
      'Memimpin kelas yoga untuk pemula hingga menengah selama 60 menit.',
      'Memberikan adjustment secara verbal.',
    ],
  },
];

const classTypes = ['Kelas privat', 'Kelas grup / komunitas', 'Kelas studio', 'Kids Yoga', 'Kelas online'];
const title = `${profile.nickname} (${profile.fullName}) — ${profile.role}`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={profile.summary} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.summary} />
    <meta property="og:image" content={new URL(photo.src, Astro.site).toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <svg class="mandala" viewBox="-100 -100 200 200">
        {Array.from({ length: 16 }, (_, i) => (
          <g transform={`rotate(${i * 22.5})`}>
            <path d="M0 -20 C 10 -40, 10 -60, 0 -92 C -10 -60, -10 -40, 0 -20 Z" />
            <path d="M0 -30 C 5 -45, 5 -58, 0 -72 C -5 -58, -5 -45, 0 -30 Z" />
            <circle cx="0" cy="-96" r="2.5" />
          </g>
        ))}
        <circle r="18" /><circle r="10" />
      </svg>
    </div>

    <nav class="topnav">
      <a href="#top" class="brand">VANTI</a>
      <div class="links">
        <a href="#about">Tentang</a>
        <a href="#experience">Pengalaman</a>
        <a href="#certifications">Sertifikasi</a>
        <a href="#contact" class="cta">Contact Us</a>
      </div>
    </nav>

    <main id="top">
      <header class="hero" id="about">
        <img class="photo" src={photo.src} width="240" height="240" alt={`Foto ${profile.fullName}`} />
        <div>
          <h1>{profile.nickname.toUpperCase()} <span>({profile.fullName})</span></h1>
          <p class="role">{profile.role}</p>
          <p class="summary">{profile.summary}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#contact">Booking kelas</a>
            <a class="btn" href={`https://wa.me/${profile.waNumber}`} target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </div>
      </header>

      <div class="grid">
        <aside>
          <section class="card">
            <h2 class="chip chip-yellow">Contact</h2>
            <ul class="contact-list">
              <li>
                <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
                <a href={`tel:+${profile.waNumber}`}>{profile.phone}</a>
              </li>
              <li>
                <svg viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z" /></svg>
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </li>
              <li>
                <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
                <span>{profile.location}</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM17.5 5.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" /></svg>
                <a href={`https://instagram.com/${profile.instagram}`} target="_blank" rel="noopener">@{profile.instagram}</a>
              </li>
            </ul>
          </section>

          <section class="card">
            <h2 class="chip chip-blue">Skills</h2>
            <ul class="tags">
              {skills.map((s) => <li>{s}</li>)}
            </ul>
          </section>
        </aside>

        <div class="main-col">
          <section class="card" id="certifications">
            <h2 class="chip chip-cyan">Sertifikasi &amp; Pelatihan</h2>
            <ul class="certs">
              {certifications.map((c) => (
                <li>
                  <span class="year">{c.year}</span>
                  <div><strong>{c.name}</strong><span class="muted">{c.org}</span></div>
                </li>
              ))}
            </ul>
          </section>

          <section class="card" id="experience">
            <h2 class="chip chip-pink">Pengalaman Mengajar</h2>
            <ol class="timeline">
              {experience.map((e) => (
                <li>
                  <h3>{e.title}</h3>
                  <p class="where">{e.place} · {e.period}</p>
                  <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </div>

      <section class="card contact" id="contact">
        <div class="contact-intro">
          <h2 class="chip chip-pink">Contact Us</h2>
          <p class="lead">Tertarik ikut kelas, butuh instruktur untuk studio, kantor, atau acara komunitas? Kirim pesan dan aku akan membalas secepatnya. 🙏</p>
          <ul class="contact-quick">
            <li><a href={`https://wa.me/${profile.waNumber}`} target="_blank" rel="noopener">WhatsApp {profile.phone}</a></li>
            <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
            <li><a href={`https://instagram.com/${profile.instagram}`} target="_blank" rel="noopener">Instagram @{profile.instagram}</a></li>
          </ul>
        </div>

        <form id="contact-form" novalidate data-wa={profile.waNumber} data-email={profile.email}>
          <label>
            Nama
            <input name="name" required autocomplete="name" placeholder="Nama kamu" />
          </label>
          <label>
            Email / No. HP
            <input name="reply" required placeholder="Supaya bisa dibalas" />
          </label>
          <label>
            Jenis kelas
            <select name="type">
              {classTypes.map((t) => <option>{t}</option>)}
              <option>Lainnya</option>
            </select>
          </label>
          <label class="full">
            Pesan
            <textarea name="message" rows="5" required placeholder="Ceritakan kebutuhanmu: jadwal, jumlah peserta, lokasi, dll."></textarea>
          </label>
          <p class="form-error full" role="alert" hidden>Mohon isi nama, kontak, dan pesan.</p>
          <div class="full actions">
            <button type="submit" name="via" value="wa" class="btn btn-primary">Kirim via WhatsApp</button>
            <button type="submit" name="via" value="email" class="btn">Kirim via Email</button>
          </div>
        </form>
      </section>
    </main>

    <footer>© {new Date().getFullYear()} {profile.fullName} · <a href="/">Blog</a></footer>

    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement;
      const error = form.querySelector('.form-error') as HTMLElement;
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const via = (ev.submitter as HTMLButtonElement | null)?.value ?? 'wa';
        const data = new FormData(form);
        const get = (k: string) => String(data.get(k) ?? '').trim();
        const name = get('name'), reply = get('reply'), type = get('type'), message = get('message');
        if (!name || !reply || !message) {
          error.hidden = false;
          return;
        }
        error.hidden = true;
        const body = `Halo Kak Vanti, saya ${name}.\n\nJenis kelas: ${type}\n\n${message}\n\nKontak saya: ${reply}`;
        if (via === 'email') {
          const subject = `[Yoga] ${type} — ${name}`;
          window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        } else {
          window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(body)}`, '_blank', 'noopener');
        }
      });
    </script>

    <style is:global>
      :root {
        --ink: #2b2b33;
        --muted: #6b6b78;
        --card: rgba(255, 255, 255, 0.82);
        --line: #2b2b33;
        --yellow: #f7c948;
        --blue: #5aa9f0;
        --cyan: #22b8d6;
        --pink: #f0628f;
        --gold: #e2c27a;
        --bg-a: #fde4ec;
        --bg-b: #fff6dc;
        --bg-c: #e3f2ec;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #f1eef3;
          --muted: #b8b3c2;
          --card: rgba(36, 32, 44, 0.85);
          --line: #8f8a9c;
          --bg-a: #2a1d27;
          --bg-b: #2a261b;
          --bg-c: #1a2724;
          --gold: #6f5c33;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: 'Montserrat', system-ui, sans-serif;
        color: var(--ink);
        line-height: 1.6;
        background: var(--bg-b);
        min-height: 100vh;
      }
      a { color: inherit; }
      .bg { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: -1; background: linear-gradient(160deg, var(--bg-a) 0%, var(--bg-b) 50%, var(--bg-c) 100%); }
      .mandala {
        position: absolute; width: 640px; left: -220px; bottom: -220px;
        fill: none; stroke: var(--gold); stroke-width: 1.2; opacity: 0.55;
      }

      .topnav {
        position: sticky; top: 0; z-index: 10;
        display: flex; justify-content: space-between; align-items: center; gap: 1rem;
        padding: 0.75rem clamp(16px, 4vw, 40px);
        background: var(--card); backdrop-filter: blur(8px);
        border-bottom: 1px solid color-mix(in srgb, var(--line) 15%, transparent);
      }
      .brand { font-family: 'Poppins', sans-serif; font-weight: 700; letter-spacing: 0.2em; text-decoration: none; }
      .links { display: flex; gap: 1.1rem; align-items: center; font-size: 0.9rem; }
      .links a { text-decoration: none; }
      .links a:not(.cta) { opacity: 0.8; }
      .links a:hover { opacity: 1; }
      .cta { background: var(--pink); color: #fff !important; padding: 0.35rem 0.9rem; border-radius: 999px; font-weight: 600; }
      @media (max-width: 640px) { .links a:not(.cta) { display: none; } }

      main { max-width: 1040px; margin: 0 auto; padding: clamp(24px, 5vw, 56px) 16px; }

      .hero { display: grid; grid-template-columns: auto 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; margin-bottom: 2.5rem; }
      .photo {
        width: clamp(150px, 24vw, 240px); height: auto; aspect-ratio: 1; border-radius: 50%;
        object-fit: cover; object-position: 50% 35%;
        border: 6px solid #fff; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
      }
      h1 { font-family: 'Poppins', sans-serif; font-size: clamp(2rem, 5vw, 3rem); letter-spacing: 0.12em; margin: 0; line-height: 1.15; }
      h1 span { font-size: 0.45em; letter-spacing: 0; white-space: nowrap; }
      .role { letter-spacing: 0.4em; text-transform: uppercase; color: var(--muted); margin: 0.25rem 0 1rem; font-size: 0.9rem; }
      .summary { max-width: 52ch; margin: 0 0 1.25rem; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      @media (max-width: 640px) {
        .hero { grid-template-columns: 1fr; text-align: center; justify-items: center; }
        .hero-actions { justify-content: center; }
      }

      .btn {
        display: inline-block; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none;
        padding: 0.65rem 1.3rem; border-radius: 999px;
        border: 2px solid var(--line); background: transparent; color: var(--ink);
        transition: transform 0.15s;
      }
      .btn:hover { transform: translateY(-2px); }
      .btn-primary { background: var(--pink); border-color: var(--pink); color: #fff; }

      .grid { display: grid; grid-template-columns: 340px 1fr; gap: 1.5rem; align-items: start; }
      aside, .main-col { display: grid; gap: 1.5rem; }
      @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }

      .card {
        background: var(--card); border: 1.5px solid var(--line); border-radius: 18px;
        padding: 2rem 1.5rem 1.5rem; position: relative; scroll-margin-top: 80px;
      }
      .chip {
        position: absolute; top: 0; left: 1.25rem; transform: translateY(-50%); margin: 0;
        font-size: 0.78rem; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase;
        padding: 0.4rem 1.2rem; border-radius: 999px; border: 1.5px solid var(--line); color: #1d1d24;
      }
      .chip-yellow { background: var(--yellow); }
      .chip-blue { background: var(--blue); }
      .chip-cyan { background: var(--cyan); color: #fff; }
      .chip-pink { background: var(--pink); color: #fff; }

      .contact-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.8rem; font-size: 0.92rem; }
      .contact-list li { display: flex; gap: 0.7rem; align-items: center; overflow-wrap: anywhere; }
      .contact-list svg { width: 20px; height: 20px; flex: none; fill: var(--ink); }
      .contact-list a { text-decoration: none; }
      .contact-list a:hover { text-decoration: underline; }

      .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tags li { font-size: 0.85rem; padding: 0.3rem 0.8rem; border-radius: 999px; background: color-mix(in srgb, var(--blue) 18%, transparent); }

      .certs { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
      .certs li { display: flex; gap: 1rem; align-items: baseline; }
      .certs .year { font-weight: 700; color: var(--cyan); min-width: 3rem; }
      .certs strong { display: block; }
      .muted { color: var(--muted); font-size: 0.9rem; }

      .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; }
      .timeline > li { padding-left: 1.2rem; border-left: 3px solid var(--pink); }
      .timeline h3 { margin: 0; font-size: 1rem; letter-spacing: 0.12em; text-transform: uppercase; }
      .where { margin: 0.1rem 0 0.4rem; font-weight: 600; font-style: italic; color: var(--muted); }
      .timeline ul { margin: 0; padding-left: 1.1rem; font-size: 0.93rem; }

      .contact { margin-top: 2.5rem; display: grid; grid-template-columns: 1fr 1.3fr; gap: 2rem; }
      @media (max-width: 820px) { .contact { grid-template-columns: 1fr; } }
      .lead { margin-top: 0; }
      .contact-quick { padding-left: 1.1rem; display: grid; gap: 0.35rem; }
      form { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      form .full { grid-column: 1 / -1; }
      @media (max-width: 520px) { form { grid-template-columns: 1fr; } }
      label { display: grid; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; }
      label:has(select) { grid-column: 1 / -1; }
      input, select, textarea {
        font: inherit; font-weight: 400; color: var(--ink); width: 100%;
        padding: 0.65rem 0.8rem; border-radius: 10px;
        border: 1.5px solid color-mix(in srgb, var(--line) 35%, transparent);
        background: color-mix(in srgb, var(--card) 70%, transparent);
      }
      input:focus, select:focus, textarea:focus { outline: 2px solid var(--pink); outline-offset: 1px; }
      .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .form-error { color: var(--pink); margin: 0; font-weight: 600; }

      footer { text-align: center; padding: 2rem 16px 3rem; font-size: 0.85rem; color: var(--muted); }
    </style>
  </body>
</html>
